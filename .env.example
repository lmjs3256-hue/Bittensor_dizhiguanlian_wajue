# Copy this file to .env. Never commit the real token.
GITHUB_TOKEN=

# 事件监控（合并版）
WALLET_LINK_EVENT_CHAIN_ENABLED=1
WALLET_LINK_EVENT_GITHUB_ENABLED=1
WALLET_LINK_EVENT_CHAIN_POLL_SECONDS=2
WALLET_LINK_EVENT_GITHUB_POLL_SECONDS=300
WALLET_LINK_EVENT_PROFILE_SYNC_SECONDS=604800
WALLET_LINK_EVENT_SIMULATION_ENABLED=1
WALLET_LINK_EVENT_DB=data/event_monitor.db
WALLET_LINK_EVENT_INHERIT_LEGACY=1
WALLET_LINK_EVENT_LEGACY_DB=
