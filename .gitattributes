# 默认按文本处理，仓库里统一用 LF；Windows 脚本在检出时转 CRLF
* text=auto

*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

*.py text eol=lf
*.md text eol=lf
*.js  text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.txt text eol=lf

# 二进制/数据文件不做换行转换
*.db binary
*.sqlite binary
*.png binary
*.jpg binary
*.ico binary
