# 运行环境与本地数据（不要提交，拷贝到别的电脑后由 安装.cmd 重建）
.venv/
/data/
/logs/
# 随版本发布的预置名单（app/data/ 要进仓库，不能被上面的 /data/ 或通配 data/ 误伤）
!app/data/
!app/data/**

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 备份与临时文件
*.bak
*.tmp
*.log
*.pid

# 系统文件
.DS_Store
Thumbs.db
desktop.ini

# 离线授权与本地密钥（授权绑定机器，不进仓库）
license.key
.license-keys/

# 签发出来的授权码备份
授权码/

# 跨机迁移包（tools/migrate_runtime.py export 生成，含运行时数据，不进仓库）
migrate-*.db
*.db-journal
*.db-wal
*.db-shm

# 升级前手工备份的数据库（体积大且含运行时数据，只留在本机）
backups/

# 外发包（由 tools/make_release.py 生成，不进仓库）
*.zip
.pytest_tmp*/
.pytest_*.xml
# 公网隧道程序：首次运行 启动-公网隧道.cmd 时自动下载（约 55MB），不入库
/tools/cloudflared.exe
/tools/cloudflared.exe.part
.probe/
.workbuddy/
